#!/bin/sh
# Carry-save single-PE array with bit-plane INT mode (signed_segmented_csa_bp):
# the accepted PAYN_SC_CSA design plus the int_mode raw-bit bypass in the
# peripheral, the per-PE doubling ring and the east-edge plane combiner.
# Knobs are identical to PAYN_SC_CSA so the area delta is the BP hardware.
export TOP=payn_array_signed_segmented_csa_bp
export TECH=TSMC22
export SRC_SV="payn/variants/signed_segmented_csa_bp/payn_array_signed_segmented_csa_bp.sv"
export PERIOD=2.5
export INPUT_DELAY=1.25
export OUTPUT_DELAY=0.05
export TSMC22_CELL_TIER=sc7mcpp140z
export TSMC22_LIB_FLAVORS=svt_c30
export TSMC22_HPK_FLAVORS=svt_c30
export ZERO_PINLESS_NET_ACTIVITY=1
export TSMC22_HPK=1
export MULTIBIT_INFER=1
export CLOCK_GATE=1
export MINPOWER=0
export FLATTEN=0
export MAX_FANOUT=16
export SYN_DEFINES="${SYN_DEFINES:-PAYN_K=8 PAYN_M=16 PAYN_NH=8 PAYN_NW=8 PAYN_SEG_LOW_W=9}"
export SYN_AREA_HIGH_EFFORT=0
unset POST_LOAD_SCRIPT
