#!/bin/sh
# Carry-save lane interface (signed_segmented_csa): popcount array with the
# counters' half-adder ripple removed and signs applied by XOR plus one shared
# -M*negatives heap correction.  Knobs match PAYN_SC_POPCOUNT_INFERRED and
# sweeps/run_popcount_synth.sh so the area is directly comparable.
export TOP=payn_array_signed_segmented_csa
export TECH=TSMC22
export SRC_SV="payn/variants/signed_segmented_csa/payn_array_signed_segmented_csa.sv"
export PERIOD=2.5
export INPUT_DELAY=1.25
export OUTPUT_DELAY=0.05
export TSMC22_CELL_TIER=sc7mcpp140z
export TSMC22_LIB_FLAVORS=svt_c30
export TSMC22_HPK_FLAVORS=svt_c30
export ZERO_PINLESS_NET_ACTIVITY=1
export TSMC22_HPK=1
export MULTIBIT_INFER=1
export CLOCK_GATE=1
export MINPOWER=0
export FLATTEN=0
export MAX_FANOUT=16
export SYN_DEFINES="${SYN_DEFINES:-PAYN_K=8 PAYN_M=16 PAYN_NH=8 PAYN_NW=8 PAYN_SEG_LOW_W=9}"
export SYN_AREA_HIGH_EFFORT=0
unset POST_LOAD_SCRIPT
