#!/bin/bash
# PaYN single-PE array (payn_array).  Two APR passes, driven by flow/route.py:
#   bootstrap  SC_DISTRIBUTION_GUIDES=1: soft A-row / W-column guides for the
#              operand pipes, floating pins; its gate-level SAIF seeds the final
#              pass's workload power optimization.
#   final      SC_DISTRIBUTION_GUIDES=0 and PRE_PLACE_SCRIPT=
#              apr/scripts/payn_pre_place.tcl (the same guides, every pin fixed
#              on the tile grid), APR_DRC_AUTOSTOP_RETRY=1 (ASTRAEA's post-fill
#              strong-reroute retry without NanoRoute's auto-stop).
export TARGET=TSMC22/PAYN
export SYNTH_RUN=${SYNTH_RUN:?set SYNTH_RUN to the synthesis run name}
export TOP=payn_array
export TECH=TSMC22
export PERIOD=2.5
export TSMC22_HPK=1
# Implementation clock uncertainty (ASTRAEA apr.tcl): CLOCK_UNCERTAINTY if set,
# else 5% of PERIOD, for setup and hold; CLOCK_UNCERTAINTY_HOLD, if set, is the
# hold uncertainty instead (a setup-only margin).
export APR_CLOCK_UNCERTAINTY=${APR_CLOCK_UNCERTAINTY:-${CLOCK_UNCERTAINTY:-auto}}
export APR_CLOCK_UNCERTAINTY_HOLD=${APR_CLOCK_UNCERTAINTY_HOLD:-${CLOCK_UNCERTAINTY_HOLD:-}}
# Read-only final placement audit.
export PRE_REPORT_SCRIPT=apr/scripts/check_final_placement.tcl
export CORE_UTIL=${CORE_UTIL:-0.70}
export CORE_ASPECT=${CORE_ASPECT:-1.000}

if [ "${SC_DISTRIBUTION_GUIDES:-0}" = "1" ]; then
    export SC_NH=${SC_NH:?set SC_NH when SC_DISTRIBUTION_GUIDES=1}
    export SC_NW=${SC_NW:?set SC_NW when SC_DISTRIBUTION_GUIDES=1}
    export SC_DIST_HIER_PREFIX=${SC_DIST_HIER_PREFIX:-u_pe/u_array_core}
    export PRE_PLACE_SCRIPT=apr/scripts/sc_distribution_guides.tcl
fi
