#!/bin/bash
# APR for the gated C-BSG PaYN array (see syn/targets/TSMC22/PAYN_SC_GATED_CBSG).
# Same recipe as PAYN_SC_SWEEP. Use RUN_NAME=<cfg> to name each config's run.
export TARGET=TSMC22/PAYN_SC_GATED_CBSG
export SYNTH_RUN=${SYNTH_RUN:?set SYNTH_RUN to the synthesis run name}
export TOP=payn_array_gated_cbsg
export TECH=TSMC22
export PERIOD=2.5
export TSMC22_HPK=1
export POST_LOAD_SCRIPT=apr/scripts/set_clock_uncertainty.tcl
export CORE_UTIL=${CORE_UTIL:-0.70}
export CORE_ASPECT=${CORE_ASPECT:-1.000}
