#!/bin/bash
# bitmod full array (Raptor_Lake_HX) APR.  16x the cell count of the other
# baselines, so expect a correspondingly longer place-and-route.
export TARGET=TSMC22/BITMOD_ARRAY
export SYNTH_RUN=${SYNTH_RUN:?set SYNTH_RUN to the synthesis run name}
export TOP=Raptor_Lake_HX
export TECH=TSMC22
export PERIOD=2.5
export TSMC22_HPK=${TSMC22_HPK:-1}
export CORE_UTIL=${CORE_UTIL:-0.70}
export CORE_ASPECT=${CORE_ASPECT:-1.000}
export POST_LOAD_SCRIPT=${POST_LOAD_SCRIPT:-apr/scripts/set_clock_uncertainty_setup_only.tcl}
