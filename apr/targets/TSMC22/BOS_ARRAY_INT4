#!/bin/bash
# Native signed INT4 output-stationary 8x8 array APR.
export TARGET=TSMC22/BOS_ARRAY_INT4
export SYNTH_RUN=${SYNTH_RUN:?set SYNTH_RUN to the synthesis run name}
export TOP=binary_os_array_int4
export TECH=TSMC22
export PERIOD=2.5
export CORE_UTIL=${CORE_UTIL:-0.75}
export CORE_ASPECT=${CORE_ASPECT:-1.000}
# Implementation clock uncertainty (ASTRAEA apr.tcl): CLOCK_UNCERTAINTY if set, else 5% of PERIOD; setup and hold.
export APR_CLOCK_UNCERTAINTY=${APR_CLOCK_UNCERTAINTY:-${CLOCK_UNCERTAINTY:-auto}}
